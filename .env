# ============================================================
# Robinhood Chain
# ============================================================

CHAIN_ID=4663

# Production:
# Use an Alchemy endpoint once you have an API key.
RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

WS_URL=wss://robinhood-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Public fallback:
# RPC_URL=https://rpc.mainnet.chain.robinhood.com
# WS_URL=wss://feed.mainnet.chain.robinhood.com


# ============================================================
# Scanner
# ============================================================

# Pons active factory starts here.
START_BLOCK=8991118

# Number of blocks processed during historical backfill.
BLOCK_CHUNK=100

# How often we check the chain for new blocks.
POLL_SECONDS=2

# Number of confirmations before processing a block.
CONFIRMATIONS=0


# ============================================================
# Database
# ============================================================

DB_PATH=data/robinhood.db


# ============================================================
# Telegram
# ============================================================

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@your_channel


# ============================================================
# Trending
# ============================================================

TREND_INTERVAL_SECONDS=60

TREND_WINDOW_SECONDS=300

TREND_ALERT_SCORE=75

TREND_UPDATE_SCORE=60

# Don't send another trend alert for the same token
# until this many seconds have passed.
TREND_COOLDOWN_SECONDS=900


# ============================================================
# Risk / filtering
# ============================================================

# Minimum number of swaps before considering a token trending.
MIN_SWAPS_FOR_TREND=10

# Minimum unique buyers.
MIN_BUYERS_FOR_TREND=5


# ============================================================
# Explorer
# ============================================================

EXPLORER_BASE=https://robinhoodchain.blockscout.com


# ============================================================
# Runtime
# ============================================================

REQUEST_TIMEOUT=20

MAX_RETRIES=5
